{
  "name": "tatli-kavga",
  "private": true,
  "version": "1.0.0",
  "description": "Tatlı Kavga — An Istanbul Match-3 Tour",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:bundle": "npm run cap:sync && cd android && ./gradlew bundleRelease",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "android:assets": "capacitor-assets generate --android --iconBackgroundColor '#0c1832' --iconBackgroundColorDark '#0c1832' --splashBackgroundColor '#0c1832' --splashBackgroundColorDark '#0c1832'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
